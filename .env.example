# Server bind configuration (for server host)
SECURECHAT_SERVER_BIND_HOST=0.0.0.0
SECURECHAT_SERVER_BIND_PORT=65432

# Client target configuration (set on client machines)
SECURECHAT_SERVER_HOST=chat.example.com
SECURECHAT_SERVER_PORT=65432

# Shared optional tuning
SECURECHAT_BUFFER_SIZE=4096

# Public exposed port used by proxy in docker-compose.prod.yml
SECURECHAT_PUBLIC_PORT=65432
